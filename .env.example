# Supabase project settings (Project Settings → API)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service role key — server-side only, never exposed to the browser.
# Required for the calendar feed, the browser extension endpoints, and
# Google Calendar sync.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: dedicated HMAC secret for calendar-feed/extension tokens.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
CALENDAR_FEED_SECRET=

# Google Calendar sync (optional feature) — see docs/google-calendar-sync.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
