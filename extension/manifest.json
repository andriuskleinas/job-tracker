{
  "manifest_version": 3,
  "name": "Clip to Job Tracker",
  "version": "0.1.0",
  "description": "Save a job ad — salary, requirements and the full text — to Job Tracker, before the posting is taken down.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://job-tracker-rho-khaki-34.vercel.app/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip this job ad",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
